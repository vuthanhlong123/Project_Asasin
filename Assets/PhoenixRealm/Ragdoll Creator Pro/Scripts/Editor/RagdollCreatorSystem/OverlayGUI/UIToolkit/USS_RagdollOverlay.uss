/* ===== OVERLAY STYLES ===== */

.overlay-root {
    position: absolute;
    background-color: rgba(42, 42, 42, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(74, 144, 226, 1);
    min-width: 300px;
    max-width: 400px;
    max-height: 500px;
    overflow: hidden;
}

.overlay__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(60, 60, 60, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 144, 226, 0.3);
    min-height: 32px;
}

.overlay__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 1);
    flex-grow: 1;
}

.overlay__header-controls {
    flex-direction: row;
    align-items: center;
}

.overlay__xray-btn {
    margin-right: 4px;
    min-width: 50px;
    height: 20px;
    font-size: 9px;
    background-color: rgba(70, 70, 70, 1);
    border-color: rgba(90, 90, 90, 1);
    color: rgba(255, 255, 255, 1);
    border-radius: 2px;
}

.overlay__xray-btn:hover {
    background-color: rgba(80, 80, 80, 1);
    border-color: rgba(100, 100, 100, 1);
}

.overlay__tab-container {
    flex-direction: row;
    background-color: rgba(50, 50, 50, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 70, 70, 1);
}

.tab-btn {
    flex-grow: 1;
    height: 28px;
    background-color: rgba(60, 60, 60, 1);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: rgba(180, 180, 180, 1);
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 0;
    margin: 0;
}

.tab-btn:hover {
    background-color: rgba(70, 70, 70, 1);
    color: rgba(255, 255, 255, 1);
}

.tab-btn--active {
    background-color: rgba(45, 45, 45, 1) !important;
    border-bottom-color: rgba(74, 144, 226, 1) !important;
    color: rgba(74, 144, 226, 1) !important;
}

.overlay__tool-container {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(48, 48, 48, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 60, 60, 1);
}

.overlay__tool-container--hidden {
    display: none !important;
}

.tool-label {
    font-size: 10px;
    color: rgba(180, 180, 180, 1);
    margin-right: 8px;
    min-width: 30px;
}

.tool-buttons {
    flex-direction: row;
    flex-grow: 1;
}

.tool-btn {
    flex-grow: 1;
    height: 20px;
    margin: 0 1px;
    background-color: rgba(70, 70, 70, 1);
    border-color: rgba(90, 90, 90, 1);
    color: rgba(255, 255, 255, 1);
    font-size: 9px;
    -unity-font-style: bold;
    border-radius: 2px;
}

.tool-btn:hover {
    background-color: rgba(80, 80, 80, 1);
    border-color: rgba(100, 100, 100, 1);
}

.tool-btn--active {
    background-color: rgba(74, 144, 226, 1);
    border-color: rgba(74, 144, 226, 1);
    color: rgba(255, 255, 255, 1);
}

.overlay__content-scroll {
    flex-grow: 1;
    max-height: 350px;
}

.overlay__content {
    padding: 8px;
    flex-grow: 1;
    min-height: 200px;
}

/* ===== FIXED PANEL VISIBILITY ===== */
.panel {
    display: none !important;
    flex-direction: column;
}

.panel--active {
    display: flex !important;
    flex-direction: column;
}

.section {
    background-color: rgba(50, 50, 50, 1);
    border-radius: 4px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(70, 70, 70, 1);
    overflow: hidden;
}

.section__header {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(74, 144, 226, 1);
    padding: 6px 8px 4px 8px;
    background-color: rgba(55, 55, 55, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 70, 70, 1);
}

.section__content {
    padding: 8px;
}

.field {
    margin-bottom: 6px;
}

.field > .unity-base-field__label {
    font-size: 10px;
    color: rgba(200, 200, 200, 1);
    min-width: 80px;
}

.field > .unity-base-field__input {
    background-color: rgba(60, 60, 60, 1);
    border-color: rgba(80, 80, 80, 1);
    border-radius: 2px;
}

.field > .unity-base-field__input:focus {
    border-color: rgba(74, 144, 226, 1);
    background-color: rgba(65, 65, 65, 1);
}

.collider-params {
    padding: 6px;
    background-color: rgba(45, 45, 45, 1);
    border-radius: 3px;
    margin-top: 6px;
    border-width: 1px;
    border-color: rgba(65, 65, 65, 1);
}

.param-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.param-label {
    font-size: 10px;
    color: rgba(180, 180, 180, 1);
    min-width: 70px;
}

.param-field {
    flex-grow: 1;
    margin-left: 8px;
}

.limit-sliders {
    padding: 4px;
}

.limit-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.limit-slider-label {
    font-size: 10px;
    color: rgba(180, 180, 180, 1);
    min-width: 70px;
}

.limit-slider {
    flex-grow: 1;
    margin: 0 8px;
}

.limit-value-label {
    font-size: 10px;
    color: rgba(80, 227, 194, 1);
    -unity-font-style: bold;
    min-width: 35px;
    -unity-text-align: middle-right;
}

.foldout {
    margin-top: 6px;
}

.foldout > .unity-foldout__toggle {
    font-size: 10px;
    color: rgba(80, 227, 194, 1);
    -unity-font-style: bold;
}

.foldout > .unity-foldout__content {
    margin-top: 4px;
    padding-left: 12px;
}

.help-text {
    font-size: 10px;
    color: rgba(160, 160, 160, 1);
    -unity-text-align: upper-left;
    white-space: normal;
    padding: 8px;
    background-color: rgba(45, 45, 45, 1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(65, 65, 65, 1);
}

.btn--small {
    height: 20px;
    font-size: 9px;
    min-width: 40px;
    padding: 0 6px;
    background-color: rgba(70, 70, 70, 1);
    border-color: rgba(90, 90, 90, 1);
    color: rgba(255, 255, 255, 1);
    border-radius: 2px;
}

.btn--small:hover {
    background-color: rgba(80, 80, 80, 1);
    border-color: rgba(100, 100, 100, 1);
}

.btn--large {
    height: 32px;
    font-size: 12px;
    min-width: 140px;
    align-self: center;
    margin: 8px 0;
    background-color: rgba(74, 144, 226, 1);
    border-color: rgba(74, 144, 226, 1);
    color: rgba(255, 255, 255, 1);
    border-radius: 4px;
}

.btn--large:hover {
    background-color: rgba(84, 154, 236, 1);
    border-color: rgba(84, 154, 236, 1);
}

.btn--primary {
    background-color: rgba(74, 144, 226, 1) !important;
    border-color: rgba(74, 144, 226, 1) !important;
    color: rgba(255, 255, 255, 1) !important;
}

.btn--secondary {
    background-color: rgba(70, 70, 70, 1) !important;
    border-color: rgba(90, 90, 90, 1) !important;
    color: rgba(255, 255, 255, 1) !important;
}

/* Enhanced slider styling for better interaction */
.unity-slider {
    margin: 2px 0;
}

.unity-slider .unity-slider__tracker {
    background-color: rgba(70, 70, 70, 1);
    border-radius: 2px;
    height: 4px;
}

.unity-slider .unity-slider__dragger {
    background-color: rgba(74, 144, 226, 1);
    border-color: rgba(74, 144, 226, 1);
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 1px;
}

.unity-slider .unity-slider__dragger:hover {
    background-color: rgba(84, 154, 236, 1);
    border-color: rgba(84, 154, 236, 1);
}

.unity-slider .unity-slider__dragger:active {
    background-color: rgba(94, 164, 246, 1);
    border-color: rgba(94, 164, 246, 1);
}

/* ===== COLLIDER PARAMETER VISIBILITY ===== */
.collider-param {
    display: none !important;
}

.show-sphere .collider-param.sphere-param {
    display: flex !important;
}

.show-capsule .collider-param.capsule-param {
    display: flex !important;
}

.show-box .collider-param.box-param {
    display: flex !important;
}

/* ===== LIMIT SLIDER STYLING ===== */
.limit-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 4px 0;
}

.limit-slider-label {
    width: 80px;
    margin-right: 8px;
    -unity-text-align: middle-left;
    font-size: 10px;
    color: rgba(180, 180, 180, 1);
}

.limit-slider {
    flex-grow: 1;
    margin: 0 8px;
}

.limit-value-label {
    width: 50px;
    -unity-text-align: middle-right;
    font-size: 10px;
    color: rgba(150, 150, 150, 1);
}
.limit-value-field {
    width: 60px;
    margin: 0 4px;
}

.limit-value-field > .unity-base-field__input {
    background-color: rgba(60, 60, 60, 1);
    border-color: rgba(80, 80, 80, 1);
    border-radius: 2px;
    font-size: 10px;
    padding: 2px 4px;
}

.limit-value-field > .unity-base-field__input:focus {
    border-color: rgba(74, 144, 226, 1);
    background-color: rgba(65, 65, 65, 1);
}

.limit-unit-label {
    font-size: 10px;
    color: rgba(150, 150, 150, 1);
    min-width: 12px;
}

