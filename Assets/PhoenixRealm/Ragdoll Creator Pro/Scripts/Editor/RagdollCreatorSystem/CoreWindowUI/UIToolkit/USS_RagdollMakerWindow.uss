.root {
    flex-grow: 1;
    background-color: rgb(42, 42, 42);
    min-width: 400px;
    min-height: 600px;
}

.banner {
    width: 100%;
    height: 160px;
    flex-shrink: 0;
    flex-grow: 0;
    margin-bottom: 4px;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-size: 205% 100%;
    margin-top: 0;
    background-color: rgb(0, 1, 30);
}

.banner__image {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    scale-mode: scale-and-crop;
    -unity-background-scale-mode: scale-and-crop;
    background-size: 100px 100%;
}

.main-scroll {
    flex-grow: 1;
    padding: 12px;
}

.section {
    background-color: rgb(50, 50, 50);
    border-radius: 6px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    overflow: hidden;
}

.section__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background-color: rgb(60, 60, 60);
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 70, 70);
}

.section__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.section__content {
    padding: 12px;
}

.section__content--tight {
    padding: 8px;
}

.character-field {
    flex-grow: 1;
    margin-right: 8px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.character-status {
    margin-bottom: 10px;
    padding: 6px 10px;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
    border-left-width: 4px;
    border-left-color: rgb(74, 144, 226);
}

.status-text {
    color: rgb(220, 220, 220);
    font-size: 11px;
}

.sync-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.btn {
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    -unity-font-style: bold;
    font-size: 11px;
}

.btn--primary {
    background-color: rgb(74, 144, 226);
    border-color: rgb(74, 144, 226);
    color: rgb(255, 255, 255);
    min-width: 120px;
}

.btn--primary:hover {
    background-color: rgb(84, 154, 236);
    border-color: rgb(84, 154, 236);
}

.btn--secondary {
    background-color: rgb(70, 70, 70);
    border-color: rgb(90, 90, 90);
    color: rgb(255, 255, 255);
    flex-grow: 1;
    margin: 0 2px;
}

.btn--secondary:hover {
    background-color: rgb(80, 80, 80);
    border-color: rgb(100, 100, 100);
}

.btn--accent {
    background-color: rgb(80, 227, 194);
    border-color: rgb(80, 227, 194);
    color: rgb(42, 42, 42);
    min-width: 100px;
    margin: 0 2px;
}

.btn--accent:hover {
    background-color: rgb(90, 237, 204);
    border-color: rgb(90, 237, 204);
}

.btn--danger {
    background-color: rgb(220, 85, 85);
    border-color: rgb(220, 85, 85);
    color: rgb(255, 255, 255);
}

.btn--danger:hover {
    background-color: rgb(230, 95, 95);
    border-color: rgb(230, 95, 95);
}

.chains-container {
    flex-direction: column;
}

.chain-card {
    background-color: rgb(45, 45, 45);
    border-radius: 4px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgb(65, 65, 65);
    overflow: hidden;
}

.chain-card--expanded {
    border-color: rgb(74, 144, 226);
    background-color: rgb(48, 48, 48);
}

.chain-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(55, 55, 55);
    min-height: 32px;
}

.chain-header:hover {
    background-color: rgb(60, 60, 60);
}

.chain-header--expanded {
    background-color: rgb(65, 65, 65);
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 144, 226, 0.3);
}

.chain-title-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.chain-expand-toggle {
    background-color: transparent;
    border-width: 0;
    color: rgb(74, 144, 226);
    font-size: 14px;
    min-width: 24px;
    height: 20px;
    margin-right: 8px;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.chain-expand-toggle:hover {
    background-color: rgba(74, 144, 226, 0.1);
}

.chain-name-field {
    flex-grow: 1;
    margin-right: 8px;
}

.chain-actions {
    flex-direction: row;
    align-items: center;
}

.chain-order-controls {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
}

.chain-move-btn {
    background-color: transparent;
    border-width: 0;
    color: rgb(120, 120, 120);
    width: 18px;
    height: 18px;
    border-radius: 2px;
    font-size: 11px;
    margin: 0 1px;
    -unity-text-align: middle-center;
}

.chain-move-btn:hover {
    background-color: rgba(74, 144, 226, 0.1);
    color: rgb(74, 144, 226);
}

.chain-remove-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(220, 85, 85);
    color: rgb(220, 85, 85);
    width: 20px;
    height: 20px;
    border-radius: 2px;
    -unity-font-style: bold;
    font-size: 12px;
}

.chain-remove-btn:hover {
    background-color: rgb(220, 85, 85);
    color: rgb(255, 255, 255);
}

.chain-content {
    padding: 8px;
    display: none;
}

.chain-content--expanded {
    display: flex;
}

.parent-node-container {
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

.parent-node-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.parent-node-label {
    min-width: 80px;
    margin-right: 8px;
}

.parent-node-field {
    flex-grow: 1;
}

.parent-node-help {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.6);
    -unity-font-style: italic;
}

.nodes-container {
    flex-direction: column;
}

.node-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgb(40, 40, 40);
    border-radius: 3px;
    border-left-width: 2px;
    border-left-color: rgb(80, 227, 194);
    min-height: 24px;
}

.node-row:hover {
    background-color: rgb(45, 45, 45);
}

.node-field {
    flex-grow: 1;
    margin-right: 6px;
}

.node-controls {
    flex-direction: row;
    align-items: center;
}

.node-move-btn {
    background-color: transparent;
    border-width: 0;
    color: rgb(120, 120, 120);
    width: 16px;
    height: 16px;
    border-radius: 2px;
    font-size: 10px;
    margin: 0 1px;
}

.node-move-btn:hover {
    background-color: rgba(80, 227, 194, 0.1);
    color: rgb(80, 227, 194);
}

.node-remove-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(180, 60, 60);
    color: rgb(180, 60, 60);
    width: 16px;
    height: 16px;
    border-radius: 2px;
    font-size: 10px;
    margin-left: 4px;
}

.node-remove-btn:hover {
    background-color: rgb(180, 60, 60);
    color: rgb(255, 255, 255);
}

.node-buttons-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.add-node-btn {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 227, 194);
    color: rgb(80, 227, 194);
    border-width: 1px;
    height: 26px;
    border-radius: 3px;
    font-size: 11px;
    flex-grow: 1;
    margin-right: 4px;
}

.add-node-btn:hover {
    background-color: rgba(80, 227, 194, 0.1);
}

.auto-add-node-btn {
    background-color: rgb(60, 60, 60);
    border-color: rgb(74, 144, 226);
    color: rgb(74, 144, 226);
    border-width: 1px;
    height: 26px;
    border-radius: 3px;
    font-size: 11px;
    flex-grow: 1;
    margin-left: 4px;
}

.auto-add-node-btn:hover {
    background-color: rgba(74, 144, 226, 0.1);
}

.validation-section {
    max-height: 200px;
}

.validation-scroll {
    max-height: 150px;
}

.validation-container {
    flex-direction: column;
}

.validation-item {
    padding: 6px 8px;
    margin-bottom: 3px;
    border-radius: 3px;
    border-left-width: 3px;
    font-size: 11px;
}

.validation-item--error {
    background-color: rgba(220, 85, 85, 0.1);
    border-left-color: rgb(220, 85, 85);
    color: rgb(255, 200, 200);
}

.validation-item--warning {
    background-color: rgba(255, 193, 7, 0.1);
    border-left-color: rgb(255, 193, 7);
    color: rgb(255, 235, 200);
}

.validation-item--info {
    background-color: rgba(74, 144, 226, 0.1);
    border-left-color: rgb(74, 144, 226);
    color: rgb(200, 220, 255);
}

.hidden {
    display: none;
}
.preset-buttons-container {
    flex-direction: row;
    justify-content: space-between;
    margin: 8px 0;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

.save-preset-btn,
.load-preset-btn {
    flex: 1;
    margin: 0 4px;
    padding: 8px;
    background-color: rgb(70, 130, 180);
    color: white;
    border-radius: 4px;
    -unity-font-style: bold;
}

.save-preset-btn:hover,
.load-preset-btn:hover {
    background-color: rgb(90, 150, 200);
}
