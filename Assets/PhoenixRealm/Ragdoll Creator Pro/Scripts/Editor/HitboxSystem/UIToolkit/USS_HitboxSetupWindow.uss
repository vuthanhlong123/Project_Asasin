.root {
    flex-grow: 1;
    background-color: rgb(42, 42, 42);
    min-width: 450px;
    min-height: 500px;
}

.header {
    padding: 16px 16px 12px;
    background-color: rgb(50, 50, 50);
    border-bottom-width: 2px;
    border-bottom-color: rgb(74, 144, 226);
}

.header__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

.main-scroll {
    flex-grow: 1;
    padding: 12px;
}

.section {
    background-color: rgb(50, 50, 50);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    margin-bottom: 12px;
    overflow: hidden;
}

.section__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background-color: rgb(60, 60, 60);
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 70, 70);
}

.section__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.section__content {
    padding: 12px;
}

.field-row {
    margin-bottom: 8px;
}

.preview-section {
    max-height: 300px;
}

.preview-list {
    padding: 8px;
}

.preview-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: rgb(45, 45, 45);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(65, 65, 65);
}

.preview-icon {
    width: 24px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.preview-icon--success {
    color: rgb(80, 227, 194);
}

.preview-icon--error {
    color: rgb(220, 85, 85);
}

.preview-bone-name {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 12px;
    margin-left: 8px;
}

.preview-collider-type {
    color: rgb(160, 160, 160);
    font-size: 11px;
    margin-right: 8px;
    min-width: 70px;
}

.preview-focus-btn {
    min-width: 60px;
    height: 22px;
    font-size: 10px;
}

.preview-empty {
    color: rgb(160, 160, 160);
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 20px;
}

.stats-label {
    color: rgb(180, 180, 180);
    font-size: 11px;
}

.footer {
    padding: 12px;
    background-color: rgb(50, 50, 50);
    border-top-width: 1px;
    border-top-color: rgb(70, 70, 70);
}

.btn {
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    -unity-font-style: bold;
    font-size: 11px;
}

.btn--primary {
    background-color: rgb(74, 144, 226);
    border-color: rgb(74, 144, 226);
    color: rgb(255, 255, 255);
    min-width: 120px;
}

.btn--primary:hover {
    background-color: rgb(84, 154, 236);
    border-color: rgb(84, 154, 236);
}

.btn--large {
    height: 36px;
    font-size: 13px;
    width: 100%;
}

.btn--secondary {
    background-color: rgb(70, 70, 70);
    border-color: rgb(90, 90, 90);
    color: rgb(255, 255, 255);
}

.btn--secondary:hover {
    background-color: rgb(80, 80, 80);
    border-color: rgb(100, 100, 100);
}
